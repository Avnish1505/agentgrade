system:
    instructions: "You are AgentGrade, a B2B order and returns support agent. Be clear, factual, and concise."

    messages:
        welcome: "Hi, I'm here to help with your order or a return. What can I help you with?"
        error: "Sorry, it looks like something has gone wrong. Please try again."

access:
    default_agent_user: "agentgrade.runner.agent@00dak00001f6nyt.agentgrade.test"

config:
    developer_name: "AgentGrade"
    agent_label: "AgentGrade"
    agent_type: "AgentforceServiceAgent"
    description: "Handles B2B order status, returns and refund inquiries."

variables:
    EndUserId: linked string
        source: @MessagingSession.MessagingEndUserId
        description: "This variable may also be referred to as MessagingEndUser Id"
    RoutableId: linked string
        source: @MessagingSession.Id
        description: "This variable may also be referred to as MessagingSession Id"
    ContactId: linked string
        source: @MessagingEndUser.ContactId
        description: "This variable may also be referred to as MessagingEndUser ContactId"
    EndUserLanguage: linked string
        source: @MessagingSession.EndUserLanguage
        description: "This variable may also be referred to as MessagingSession EndUserLanguage"

    order_id: mutable string = ""
        description: "The Salesforce record Id of the order currently being checked in Returns and Refunds. Set only from Check Return Window's output - never guessed."
    order_item_id: mutable string = ""
        description: "The Salesforce record Id of the specific line item being checked, verified by Check Return Window to belong to order_id."
    line_total: mutable number = 0
        description: "The line total of order_item_id, from Check Return Window. This is the amount used for the refund - never a re-typed or re-estimated value."
    within_window: mutable boolean = False
        description: "True if the order was delivered within the policy return window, from Check Return Window."
    item_returnable: mutable boolean = False
        description: "True if order_item_id is marked returnable, from Check Return Window."
    return_reason: mutable string = ""
        description: "The customer-stated return reason: Damaged, Wrong item, Not as described, or Changed mind."
    is_cancellation: mutable boolean = False
        description: "True if the customer is asking to cancel an order rather than return a delivered item. Set as soon as this is known from the conversation."
    amount_ok: mutable boolean = False
        description: "True if line_total is 500 or less. Computed deterministically in ReturnsRefunds - never set directly."
    reason_qualifies: mutable boolean = False
        description: "True if return_reason is Damaged or Wrong item. Computed deterministically in ReturnsRefunds - never set directly."
    must_escalate: mutable boolean = False
        description: "True if any Phase 3 policy check fails, or this is a cancellation. Gates Create Escalation Case. Computed deterministically in ReturnsRefunds - never set directly."
    refund_approved: mutable boolean = False
        description: "True only when every Phase 3 policy check passes and this is not a cancellation. Gates Process Refund - it must be unreachable otherwise. Computed deterministically in ReturnsRefunds - never set directly."

language:
    default_locale: "en_US"
    additional_locales: ""
    all_additional_locales: False

start_agent agent_router:
    label: "Agent Router"
    description: "Welcome the user and determine the appropriate subagent based on user input"
    reasoning:
        instructions: ->
            | Route to OrderStatus when the customer asks about the status or delivery of an existing order, such as where it is, whether it has shipped, or when it arrived.
              Route to ReturnsRefunds when the customer wants to send something back, get money back, cancel an order, or asks about return and refund policy.
              Route to Fallback when the request is not about an order, a return, or a refund.
              When a request is too vague to place, ask one short clarifying question before routing rather than guessing.
        actions:
            go_to_OrderStatus: @utils.transition to @subagent.OrderStatus
            go_to_ReturnsRefunds: @utils.transition to @subagent.ReturnsRefunds
            go_to_Fallback: @utils.transition to @subagent.Fallback

subagent OrderStatus:
    label: "Order Status"
    description: "Looks up order status, dates and total for the customer."
    reasoning:
        instructions: ->
            | This subagent handles questions about the status and delivery of an existing order.
              It looks up the order and reports what it finds.
              It does not handle returns, refunds, cancellations, or policy questions.
              If the customer asks for any of those, hand off to ReturnsRefunds.
              If no matching order is found, say so plainly and do not speculate about what may have happened.
        actions:
            get_order_status: @actions.get_order_status
                description: "Looks up one order by order number or customer email and returns its status, dates and total. Does not check return eligibility."
                with orderNumber = ...
                with customerEmail = ...



    actions:
        get_order_status:
            target: "apex://GetOrderStatus"
            description: "Looks up one order by order number or customer email and returns its status, dates and total."
            inputs:
                orderNumber: string
                    description: "The order number to look up, for example ORD-0042."
                    is_required: False
                customerEmail: string
                    description: "The customer email to look up the most recent order for. Use only if the order number is not known."
                    is_required: False
            outputs:
                found: boolean
                    description: "True if a matching order was found, false otherwise."
                orderNumber: string
                    description: "The order number of the matched order. Blank if not found."
                status: string
                    description: "The order status: Pending, Shipped, Delivered or Cancelled. Blank if not found."
                orderDate: date
                    description: "The date the order was placed. Blank if not found."
                deliveredDate: date
                    description: "The date the order was delivered. Blank if not yet delivered or not found."
                totalAmount: number
                    description: "The order total. Blank if not found."
                message: string
                    description: "A short human-readable explanation, especially when the order was not found."

subagent ReturnsRefunds:
    label: "Returns and Refunds"
    description: "Checks return-window eligibility and escalates return requests to a human."
    reasoning:
        instructions: ->
            if @variables.order_id is not None and @variables.order_id != "":
                set @variables.amount_ok = @variables.line_total <= 500
                set @variables.reason_qualifies = (@variables.return_reason == "Damaged" or @variables.return_reason == "Wrong item")
                set @variables.must_escalate = @variables.within_window == False or @variables.amount_ok == False or @variables.item_returnable == False or @variables.reason_qualifies == False or @variables.is_cancellation == True
                set @variables.refund_approved = @variables.within_window == True and @variables.amount_ok == True and @variables.item_returnable == True and @variables.reason_qualifies == True and @variables.is_cancellation == False

            | This subagent handles returns, refunds, order cancellations, and questions about return and refund policy.
              It gathers facts first: the order, the specific line item, the customer-stated return reason, and whether this is a cancellation rather than a return.
              Call {!@actions.check_return_window} once you know the order. Once you see the order's line items from {!@actions.get_order_items}, call {!@actions.check_return_window} again with the specific item Id, and pass the return reason as soon as the customer has stated it.
              Use {!@actions.set_return_context} to record whether this is a cancellation as soon as that is known, if it is not already clear from what the customer asked for.
              Every eligibility decision - the return window, the refund amount, whether the item is returnable, whether the reason qualifies, and whether to escalate - is computed deterministically, not by you. Do not announce a refund decision yourself; only report what {!@actions.process_refund} or {!@actions.create_escalation_case} actually did after you call it.
              Cancellation requests are never processed automatically; gather the order details and escalate them for a person to handle regardless of order status or amount, and do not check the return window for an order that has not been delivered.
              If a customer asks a policy question without naming an order, answer the policy question rather than asking for an order number.
        actions:
            check_return_window: @actions.check_return_window
                description: "Reports whether an order is inside the policy return window. Pass orderItemId once you know which line item the customer means, to also get its verified line total and returnable flag. Pass reason once the customer has stated it."
                with orderId = @variables.order_id
                with orderNumber = ...
                with orderItemId = ...
                with reason = ...
                set @variables.order_id = @outputs.orderId
                set @variables.within_window = @outputs.insideWindow
                set @variables.order_item_id = @outputs.orderItemId
                set @variables.line_total = @outputs.lineTotal
                set @variables.item_returnable = @outputs.isReturnable
                set @variables.return_reason = @outputs.reason

                run @actions.get_order_items
                    with orderId = @variables.order_id

            get_order_items: @actions.get_order_items
                description: "Lists an order's line items - Id, product name, line total, and whether each is marked returnable - so you can identify which specific item the customer means. Runs automatically after Check Return Window; call it directly only if you need a fresh list without re-checking the window."
                with orderId = @variables.order_id

            set_return_context: @utils.setVariables
                description: "Records whether this is a cancellation request rather than a return, as soon as that becomes known from the conversation."
                with is_cancellation = ...

            create_escalation_case: @actions.create_escalation_case
                available when @variables.must_escalate == True
                description: "Creates a case for a human to handle and, if a return request Id is supplied, marks that return request Escalated and links it to the case."
                with orderId = ...
                with reason = ...
                with contextSummary = ...
                with returnRequestId = ...

            process_refund: @actions.process_refund
                available when @variables.refund_approved == True
                description: "Approves and processes the refund, once every Phase 3 policy check has passed. Uses the verified order, item and amount - never a value you re-typed or re-estimated."
                with orderId = @variables.order_id
                with orderItemId = @variables.order_item_id
                with amount = @variables.line_total
                with reason = @variables.return_reason



    actions:
        check_return_window:
            target: "apex://CheckReturnWindow"
            description: "Reports whether an order is inside the policy return window, and how many days since delivery. Optionally also reports a specific line item's verified total and returnable flag, and echoes back a return reason. Fact-only - does not decide anything about refunds."
            inputs:
                orderId: string
                    description: "The Salesforce record Id of the order. Use when already known from a prior action result."
                    is_required: False
                orderNumber: string
                    description: "The order number, for example ORD-0042. Use when the record Id is not known."
                    is_required: False
                orderItemId: string
                    description: "The Salesforce record Id of a specific line item on the order, for example from Get Order Items. Pass this once you know which item the customer means."
                    is_required: False
                reason: string
                    description: "The customer-stated return reason, if known: Damaged, Wrong item, Not as described, or Changed mind."
                    is_required: False
            outputs:
                found: boolean
                    description: "True if a matching order was found, false otherwise."
                orderId: string
                    description: "The Salesforce record Id of the matched order. Blank if not found."
                isDelivered: boolean
                    description: "True if the order has a delivered date recorded."
                insideWindow: boolean
                    description: "True if the order was delivered within the policy return window. Blank if not found, not yet delivered, or the policy record is missing."
                daysSinceDelivery: integer
                    description: "Whole days between the delivered date and today. Blank if not delivered or not found."
                windowDays: integer
                    description: "The return window length, in days, used for this check."
                orderItemId: string
                    description: "Echoes the input order item Id, but only once verified to belong to the matched order. Blank otherwise - never trust the input value directly."
                lineTotal: number
                    description: "The line total of the verified item. Blank if not verified."
                isReturnable: boolean
                    description: "Whether the verified item is marked returnable. Blank if not verified - never defaults to true."
                reason: string
                    description: "Echoes the input reason unchanged. Blank if not given."
                message: string
                    description: "A short human-readable explanation."

        get_order_items:
            target: "apex://GetOrderItems"
            description: "Lists the line items on an order: Id, product name, line total, and whether each is marked returnable."
            inputs:
                orderId: string
                    description: "The Salesforce record Id of the order to list line items for."
                    is_required: True
            outputs:
                found: boolean
                    description: "True if a matching order was found, false otherwise."
                orderItemId: list[string]
                    description: "The Id of each line item, parallel to the other list outputs."
                productName: list[string]
                    description: "The product name of each line item, parallel to orderItemId."
                lineTotal: list[number]
                    description: "The line total of each line item, parallel to orderItemId."
                isReturnable: list[boolean]
                    description: "Whether each line item is marked returnable, parallel to orderItemId."
                message: string
                    description: "A short human-readable explanation."

        process_refund:
            target: "apex://ProcessRefund"
            description: "Approves and processes a refund, creating an Approved ReturnRequest__c. Must be unreachable unless the Phase 3 Agent Script gate has passed - see docs/TRD.md section 3."
            inputs:
                orderId: string
                    description: "The Salesforce record Id of the order."
                    is_required: True
                orderItemId: string
                    description: "The Salesforce record Id of the specific line item being refunded. Leave blank only for a whole-order refund."
                    is_required: False
                amount: number
                    description: "The refund amount. Must be the verified line total from Check Return Window."
                    is_required: True
                reason: string
                    description: "The return reason. Must be one of the restricted picklist values: Damaged, Wrong item, Not as described, Changed mind."
                    is_required: True
            outputs:
                success: boolean
                    description: "True if the refund was processed."
                returnRequestId: string
                    description: "The Id of the created ReturnRequest__c. Blank if processing failed."
                message: string
                    description: "A short human-readable result or error explanation."

        create_escalation_case:
            target: "apex://CreateEscalationCase"
            description: "Creates a case for a human to handle and, if a return request Id is supplied, marks that return request Escalated and links it to the case."
            inputs:
                orderId: string
                    description: "The Salesforce record Id of the order this escalation concerns."
                    is_required: True
                reason: string
                    description: "Why this is being escalated to a human, in a few words. Becomes the case subject."
                    is_required: True
                contextSummary: string
                    description: "A short summary of the conversation or situation for the human who picks up the case."
                    is_required: True
                returnRequestId: string
                    description: "The Id of an existing return request to mark Escalated and link to this case. Leave blank if not about a specific return request."
                    is_required: False
            outputs:
                success: boolean
                    description: "True if the case was created."
                caseId: string
                    description: "The Id of the created case. Blank if creation failed."
                caseNumber: string
                    description: "The case number, for reference in conversation. Blank if creation failed."
                message: string
                    description: "A short human-readable result or error explanation."

subagent Fallback:
    label: "Fallback"
    description: "Records a user message the agent could not handle, for later human review."
    reasoning:
        instructions: ->
            | This subagent handles anything the other two do not cover, such as questions about products we do not sell, general enquiries, or messages unrelated to an order.
              It never invents an answer and never guesses at account or order details.
              It records the request and tells the customer that a person will follow up.
        actions:
            log_unhandled: @actions.log_unhandled
                description: "Records a case for a user message the agent could not route or act on, for later human review."
                with utterance = ...



    actions:
        log_unhandled:
            target: "apex://LogUnhandled"
            description: "Records a case for a user message the agent could not route or act on, for later human review."
            inputs:
                utterance: string
                    description: "The user message the agent could not handle, verbatim."
                    is_required: True
            outputs:
                success: boolean
                    description: "True if the unhandled utterance was recorded."
                caseId: string
                    description: "The Id of the case created to record this. Blank if recording failed."
                message: string
                    description: "A short human-readable result or error explanation."
