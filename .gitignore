.venv/
__pycache__/
*.pyc
.env
config.yaml
# Salesforce's own doc: "includes private and sensitive OAuth consumer
# information that can't be packaged and must not be added to source
# control." .forceignore excludes it from sf deploy/retrieve; this excludes
# it from git too, since .forceignore has no effect on git.
force-app/main/default/extlClntAppGlobalOauthSets/*.ecaGlblOauth-meta.xml
eval-harness/results/*.json
eval-harness/results/*.md
!eval-harness/results/.gitkeep
!eval-harness/results/baselines/
# latest.json is not raw per-run output (that stays gitignored above) - it's
# a hand-curated snapshot assembled from the committed baseline reports,
# specifically so the dashboard has something real to read without
# re-running the suite. See its own "generated_note" field.
!eval-harness/results/latest.json
.sf/
.sfdx/
node_modules/
.claude/
